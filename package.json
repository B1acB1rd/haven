{
    "name": "haven",
    "version": "1.0.0",
    "description": "Haven - Your creative sanctuary for AI tools and productivity",
    "main": "dist-electron/electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
        "preview": "vite preview",
        "electron:compile": "tsc -p tsconfig.electron.json",
        "electron:dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run electron:compile && vite build && electron-builder",
        "test": "vitest",
        "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
    },
    "keywords": [
        "electron",
        "react",
        "ai",
        "creative",
        "desktop"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@types/sql.js": "^1.4.9",
        "bcryptjs": "^3.0.3",
        "electron-store": "^8.1.0",
        "isomorphic-dompurify": "^2.35.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.303.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.21.0",
        "sql.js": "^1.13.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.0.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@types/uuid": "^9.0.7",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "vitest": "^1.1.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.haven.app",
        "productName": "Haven",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.png"
        },
        "mac": {
            "target": "dmg",
            "icon": "build/icon.png"
        },
        "linux": {
            "target": "AppImage",
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "publish": {
            "provider": "github",
            "owner": "YOUR_GITHUB_USERNAME",
            "repo": "haven"
        }
    }
}